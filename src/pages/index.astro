---
import { Image } from "astro:assets";
import GamePreview from "@/src/components/GamePreview.astro";
import InlineLink from "@/src/components/InlineLink.astro";
import Link from "@/src/components/Link.astro";
import PersonProfile from "@/src/components/PersonProfile.astro";
import Row from "@/src/components/Row.astro";
import SectionTitle from "@/src/components/SectionTitle.astro";
import {
	logo,
	instagram,
	mastodon,
	bluesky,
	lucid_labs,
	clippy_book,
	octonet,
	dreamcatcher,
	key_of_dreams,
	locksmiths_dream,
	ttktm,
	event_crowd,
	dinos,
	sarah,
	michael,
	catalin,
	benb,
	benfer,
	harry1,
	harry2,
    crikkitt_coffee,
} from "@/src/images";
import Layout from "@/src/layouts/Layout.astro";
import Navbar from "@/src/components/Navbar.astro";
---

<Layout>
	<div class="container text-center flex flex-col items-center">
		<Image
			src={logo}
			alt="Sleeping cat logo"
			loading="eager"
			height={200}
			class="mt-4"
		/>
		<h1 class="text-4xl py-4 font-bold">Hi! We're Dreamcat.</h1>
	</div>
	<Row inverted class="mb-0">
		<div class="flex flex-row justify-between items-center">
			<div class="flex flex-col items-center w-full">
				<p class="font-bold pb-4">
					We make interactive puzzle experiences that uniquely blend
					escape rooms, treasure hunts and video games.
				</p>
				<p>Intrigued? Then we're going to get along very nicely.</p>
			</div>
			<div>
				<Link
					href="https://www.instagram.com/dreamcat.puzzles/"
					className="hover:opacity-70"
				>
					<Image src={instagram} height={45} alt="Instagram" />
				</Link>
				<br />
				<Link
					href="https://mastodon.me.uk/@dreamcat"
					className="hover:opacity-70"
					><Image src={mastodon} height={45} alt="Mastodon" /></Link
				>
				<br />
				<Link
					href="https://bsky.app/profile/dreamcatpuzzles.bsky.social"
					className="hover:opacity-70"
					><Image src={bluesky} height={45} alt="Bluesky" /></Link
				>
			</div>
		</div>
	</Row>

	<Navbar />

	<Row>
		<SectionTitle id="portfolio">Our games</SectionTitle>
		<div class="flex flex-wrap justify-between">
			<GamePreview
			href="/coffee"
			image={crikkitt_coffee}
			imageAlt="Text 'Crikkitt Coffee'. Logo for a coffeeshop with beans and a cup"
			name="???"
			description=""/>
			<GamePreview
				href="/lucid-labs"
				image={lucid_labs}
				imageAlt="Lucid Labs logo, concentric multicoloured circles"
				name="Lucid Labs (2025)"
				description="'Lucidation protocol online. System activates in three... two... one...'"
			/>
			<GamePreview
				href="/who-killed-clippy"
				image={clippy_book}
				imageAlt="Pixel art book with question mark cover"
				name="Who Killed Clippy? (2024)"
				description="It looks like you're trying to solve my murder. Would you like help?"
			/>
			<GamePreview
				href="/octonet"
				image={octonet}
				imageAlt="Geometric octopus logo with text: OCTONET. The web. Untangled."
				name="OCTONET (2022)"
				description="Untangle a corporate conspiracy."
			/>
			<GamePreview
				href="https://dreamcatcher-puzzle.gitlab.io/dreamcatcher/"
				image={dreamcatcher}
				imageAlt="Abstract geometric pattern with circles and squares, reminiscent of a circuit board"
				name="Dreamcatcher (2018)"
				description="The Machine thinks. But it needs dreams."
			/>
		</div>

		<SectionTitle id="commissions">Our collaborations</SectionTitle>
		<div class="flex flex-wrap justify-between">
			<GamePreview
				href="https://www.thekeyofdreams.co.uk"
				image={key_of_dreams}
				imageAlt="Ominous tree lit from behind by warm light"
				name="The Key of Dreams (2024-)"
				description="A theatre experience inspired by classic works of gothic and cosmic horror."
			/>
			<GamePreview
				href="https://www.locksmithsdream.com/"
				image={locksmiths_dream}
				imageAlt="Disorienting view up a square spiral staircase... or is it down?"
				name="The Locksmith's Dream (2022-23)"
				description="Puzzle design for an immersive experience like no other."
			/>
			<GamePreview
				href="https://audioboom.com/posts/7921770-the-wishing-fish-clock"
				image={ttktm}
				imageAlt="Man in spy hat and trenchcoat looks furtively through a filing cabinet. On the drawer is a golden hare"
				name="The Town That Knew Too Much"
				description="A secret message hidden in a podcast about the 1979 book Masquerade."
			/>
		</div>
	</Row>

	<Row inverted>
		<SectionTitle>Events</SectionTitle>
		<p>
			We can do one of our games at your wedding, party, corporate event,
			you name it. <InlineLink href="/events">Find out more!</InlineLink>
		</p>
		<p>
			"Everyone had a fantastic time and thoroughly enjoyed themselves.
			Would highly recommend."
		</p>
		<p>— Yee, Risilience (Cambridge)</p>
		<Image
			src={event_crowd}
			alt="A crowd of people looking intently at a puzzle"
			class="h-[300px] w-full object-cover"
		/>
	</Row>

	<Row>
		<SectionTitle>Commissions and Partnerships</SectionTitle>
		<p>
			We don't just work alone. We'll work with you to design an
			experience that will knock guests' socks off.
		</p>
		<p>
			Our approach: understand your audience, figure out what they find
			fun, do our own reading and research, and turn all of that into a
			series of puzzles that integrate seamlessly with the rest of your
			experience.
		</p>
		<p>
			Not everybody is an expert at puzzles, so we always tailor
			experiences to complement the rest of the event, and ensure that
			they are fun for everyone in the audience, regardless of age or
			puzzling experience.
		</p>
		<p>
			To find out more about our design process, head over to <InlineLink
				href="https://blog.dreamcat.uk/">our blog</InlineLink
			>.
		</p>
		<Image
			src={dinos}
			alt="Close up of a game board with hexagonal dinosaur bone pieces"
			class="h-[300px] w-full object-cover"
		/>
	</Row>

	<Row inverted>
		<SectionTitle id="team">Meet the team</SectionTitle>
		<div class="flex flex-wrap justify-between">
			<PersonProfile
				image={sarah}
				name="Sarah Binney"
				title="Chief Paperclip Duplicator"
			/>
			<PersonProfile
				image={michael}
				name="Michael Kearns"
				title="Director of Paperclip Counting"
			/>
			<PersonProfile
				image={catalin}
				name="Catalin Lafita-Ursachi"
				title="Principal Paperclip De-duplicator"
			/>
			<PersonProfile
				image={benb}
				name="Ben Below"
				title="Head of Multiplayer Solitaire"
			/>
			<PersonProfile
				image={harry1}
				name="Harry Cummings"
				title="Non-Denominational Nerd"
			/>
			<PersonProfile name="Alicia Lafita Ursachi" />
			<PersonProfile image={benfer} name="Benjamin Fernandes" />
			<PersonProfile name="Caz Yang" />
			<PersonProfile image={harry2} name="Harry Best" />
			<PersonProfile name="Lewis Wakeland" />
			<PersonProfile name="Rin Shaw" />
			<PersonProfile name="Shiv Chandarana" />
			<PersonProfile name="Wai-Wai Ng" />
		</div>
	</Row>

	<Row>
		<SectionTitle id="contact">Get in touch</SectionTitle>
		<p>
			Interested in what we do? Drop us a line at <InlineLink
				href="mailto:hi@dreamcat.uk">hi@dreamcat.uk</InlineLink
			>, we love to talk about puzzles!
		</p>
	</Row>
</Layout>
