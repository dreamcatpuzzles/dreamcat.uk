---
import { Image } from "astro:assets";
import Navbar from "@/src/components/Navbar.astro";
import { caffeine_rush_banner } from "@/src/images";
import Row from "@/src/components/Row.astro";
import Link from "@/src/components/Link.astro";
import InlineLink from "@/src/components/InlineLink.astro";
import SectionTitle from "@/src/components/SectionTitle.astro";
import Layout from "@/src/layouts/Layout.astro";
import Buzzshot from "@/src/buzzshot.astro";
---

<Layout>
    <Navbar />
    <div class="bg-beige flex flex-col items-center pb-8 px-2 text-center">
        <Image
            src={caffeine_rush_banner}
            alt="Text Caffeine Rush in a playful font. A coffee cup spilling coffee"
            height={300}
            class="pt-8"
        />
    </div>
    <Row className="bg-brick border-none">
        <p class="text-center">
            <Link href="#bz-target" className="text-beige font-nougat text-3xl underline hover:no-underline hover:opacity-70">
                Book now &gt;
            </Link>
        </p>
    </Row>
    <Row className="bg-mikey border-none">
        <p class="text-center">
            <Link href="https://www.youtube.com/watch?v=D4Xm4sC1ZAg" className="underline font-bold text-beige">
                "The most fun I've had in, like, four, five months"
            </Link>
        </p>
        <p class="text-right text-beige">--- Quinns, Quinns Quest / People Make Games</p>
    </Row>

    <Row className="bg-black border-none text-brick">
        <p class="text-2xl font-nougat">Baristas Wanted at Tony's Cafe</p>
        <p class="text-md text-mikey">...where the kitchen is heating up. Your job as baristas: serve all the customers before the time runs out. But you'd better stay on your toes - who knows what curveballs you'll have to deal with next?</p>
    </Row>
    <Row className="bg-beige border-none">
        <div class="flex flex-wrap justify-center gap-8 text-center text-mikey">
            <div>
                Time: 60 minutes
            </div>
            <div>
                Players: 2-6
            </div>
            <div>
                Type: Frantic
            </div>
        </div>
    </Row>
    <Buzzshot />
    <Row>
        <SectionTitle>Stay in the loop</SectionTitle>
        <p>
            Want to hear more about our next experience? Sign up for our <InlineLink
                href="https://buttondown.email/DreamcatPuzzles"
                >newsletter</InlineLink
            >!
        </p>
    </Row>
</Layout>
