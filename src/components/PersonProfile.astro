---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { logo } from "../images/index";

const { image, name, title } = Astro.props as {
    image?: string | ImageMetadata;
    name: string;
    title?: string;
};
---

<div class="pb-4">
    {typeof image === "string" ? (
        <img src={image} alt={`Portrait of ${name}`} width={300} height={300} />
    ) : (
        <Image
            src={image || logo}
            alt={image ? `Portrait of ${name}` : "Placeholder portrait"}
            width={300}
            height={300}
        />
    )}
    <h3 class="font-bold text-center pt-4">{name}</h3>
    {title && <p class="text-center">{title}</p>}
</div>
