---
import Link from "./Link.astro";
import NavbarLi from "./NavbarLi.astro";
import Navbar from "./Navbar";
import { logo } from "@/src/images";
import { Image } from "astro:assets";

const { showLogo = true }: { showLogo?: boolean } = Astro.props;
---

<Navbar client:load>
    <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between">
    {showLogo && (
        <Link href="/" className="font-bold hover:underline flex flex-row">
            <Image
                src={logo}
                alt="Dreamcat logo"
                class="w-6 h-6 mr-2"
            /> Dreamcat
        </Link>
    )}
    <ul id="primary-navigation" class="hidden flex-col gap-2 group-data-[menu-open=true]:flex sm:flex sm:flex-row sm:gap-0">
        <NavbarLi>
            <Link className="hover:underline" href="/#portfolio">Our work</Link>
        </NavbarLi>
        <NavbarLi>
            <Link className="hover:underline" href="/events">Events</Link>
        </NavbarLi>
        <NavbarLi>
            <Link className="hover:underline" href="/#commissions">Commissions</Link>
        </NavbarLi>
        <NavbarLi>
            <Link className="hover:underline" href="/#team">Meet the team</Link>
        </NavbarLi>
        <NavbarLi>
            <Link className="hover:underline" href="https://blog.dreamcat.uk">Blog</Link>
        </NavbarLi>
        <NavbarLi>
            <Link className="hover:underline" href="/#contact">Contact us</Link>
        </NavbarLi>
    </ul></div>
</Navbar>