---
import { cn } from "@/src/cn";

const {
    inverted = false,
    className,
}: { inverted?: boolean; className?: string } = Astro.props;
const colours = inverted
    ? "border-salmon bg-pale text-midnight"
    : "border-grape bg-midnight text-pale";
---

<div class={cn("py-8 border-b-12", colours, className)}>
    <div class="container">
        <slot />
    </div>
</div>
