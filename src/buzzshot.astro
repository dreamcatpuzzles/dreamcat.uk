<div id="bz-target"/>
<script data-target="#bz-target">
/**/


(function () {
  "use strict";
  const defaultIframeUrl = "https://dreamcat.buzzshot.net/9a44dd48-d974-4672-891c-dd7351721ff1/";
  const brandColor = "#2c2960";
  const widgetId = "9a44dd48-d974-4672-891c-dd7351721ff1";
  const customElement = "" || (document.currentScript && document.currentScript.getAttribute("data-custom-element", ""))
  const cartStorageKey = "buzzshotCart";
  const langStorageKey = "buzzshotLang";

  var MIN_HEIGHT = 600;
  var expectedUrl = new URL(defaultIframeUrl, window.location);

  // Read flags from the embed script's own URL (e.g. embed.js?create=no).
  function getScriptParam(name) {
    var script = document.currentScript;
    if (!script || !script.src) return null;
    try {
      return new URL(script.src, window.location).searchParams.get(name);
    } catch (e) {
      return null;
    }
  }

  // Matches a leading widget UUID segment (e.g. /UUID/...). Used to
  // distinguish the UUID-prefixed form of widget URLs from the
  // default-widget form. Cart/order UUIDs deeper in the path are not matched.
  var WIDGET_UUID_PREFIX_RE = /^\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(\/|$)/i;

  // Whether the embed script itself was loaded with the widget UUID in its
  // path (/<uuid>/embed/...) or in the default-widget form (/embed/...).
  // In takeover mode this controls which iframes we accept.
  var scriptHasWidgetId = (function() {
    var script = document.currentScript;
    if (!script || !script.src) return true;
    try {
      return new URL(script.src, window.location).pathname.indexOf(widgetId) !== -1;
    } catch (e) {
      return true;
    }
  })();

  // Wire up the parent <-> iframe bridge for an iframe that's already in the
  // page. Used both for iframes we create and for takeover mode.
  function attachIframeBridge(iframe, options) {
    options = options || {};
    window.dataLayer = window.dataLayer || [];
    var resizingTimeoutId;
    var lastSize = MIN_HEIGHT;
    // True between an externalNavigation we acted on and the next
    // pageNavigation. Lets the revert path know to also undo the height we
    // stretched, and avoids reverting scrolling on routine in-widget navs
    // where we never changed it.
    var expandedForOffOrigin = false;

    // Whether the parent drives the iframe's viewport (true when the iframe
    // doesn't scroll itself, so its content height matches its element height
    // and the parent has to forward its own scroll position). When the iframe
    // has its own scrolling, the parent's viewport calculations don't apply
    // and the iframe should rely on its own scroll/CSS sticky instead.
    function parentDrivesViewport() {
      return iframe.getAttribute("scrolling") === "no";
    }

    function sendIframeViewportPosition() {
      if (!iframe.contentWindow) return;
      if (!parentDrivesViewport()) return;
      var rect = iframe.getBoundingClientRect();
      var visibleTopInParent = Math.max(rect.top, 0);
      var visibleBottomInParent = Math.min(window.innerHeight, rect.top + rect.height);
      var visibleHeight = Math.max(0, visibleBottomInParent - visibleTopInParent);
      var visibleTopInIframe = Math.max(0, -rect.top);
      iframe.contentWindow.postMessage(
        {
          type: "viewportOffset",
          widgetId: widgetId,
          top: visibleTopInIframe,
          height: visibleHeight
        },
        expectedUrl.origin
      );
    }

    function sendEmbedConfig() {
      if (!iframe.contentWindow) return;
      iframe.contentWindow.postMessage(
        {
          type: "embedConfig",
          widgetId: widgetId,
          parentDrivesViewport: parentDrivesViewport()
        },
        expectedUrl.origin
      );
    }

    // Bring the widget back into view when navigation has left its top above
    // the viewport.
    function scrollWidgetIntoView() {
      if (iframe.getBoundingClientRect().top < 0) {
        iframe.scrollIntoView({ behavior: "smooth" });
      }
    }

    // Send synchronously on scroll so the message lands in time for the next
    // paint. Deferring via rAF adds a frame of latency that reads as jitter
    // inside the iframe, where the sticky CTA visibly lags parent scroll.
    //
    // Capture phase (not bubble): scroll events don't bubble, so a bubble-phase
    // window listener only fires when the window itself scrolls. Many host pages
    // scroll an inner element instead — a theme wrapper with overflow:auto, or a
    // smooth-scroll library (Lenis/Locomotive) that scrolls a transformed
    // container while window.scrollY stays 0. Those inner scrolls still move the
    // iframe within the viewport but never reach a bubble-phase window listener,
    // so viewportOffset goes stale and the floating CTA is pinned to the wrong
    // line (parking mid-page). Capture phase sees scroll on any element.
    window.addEventListener("scroll", sendIframeViewportPosition, { passive: true, capture: true });
    window.addEventListener("resize", sendIframeViewportPosition);
    iframe.addEventListener("load", function() {
      sendEmbedConfig();
      setTimeout(function() {
        sendEmbedConfig();
        sendIframeViewportPosition();
      }, 100);
    });
    // In takeover mode the iframe may already be loaded by the time we find it.
    sendEmbedConfig();
    setTimeout(function() {
      sendEmbedConfig();
      sendIframeViewportPosition();
    }, 100);

    window.addEventListener("message", function(event) {
      var eventUrl;
      try { eventUrl = new URL(event.origin); } catch(e) { return; }
      if (eventUrl.hostname !== expectedUrl.hostname || eventUrl.protocol !== expectedUrl.protocol) return;
      var message = event.data;
      if (message && message.widgetId === widgetId) {
        if (message.type === "setHeight") {
          // Only auto-resize iframes that have scrolling disabled — if the
          // page author left scrolling enabled they've opted into letting the
          // iframe scroll itself, so we mustn't override its height.
          if (iframe.getAttribute("scrolling") !== "no") return;
          if (message.height >= MIN_HEIGHT) {
            clearTimeout(resizingTimeoutId);
            if (message.height > lastSize) {
              lastSize = message.height;
              iframe.style.height = message.height + "px";
            } else {
              resizingTimeoutId = setTimeout(function () {
                if (iframe.getAttribute("scrolling") !== "no") return;
                lastSize = message.height;
                iframe.style.height = message.height + "px";
              }, 500);
            }
          }
        } else if (message.type === "dataLayer") {
          // GA4: Clear previous ecommerce data before pushing new ecommerce events
          if (message.detail && typeof message.detail === 'object' && 'ecommerce' in message.detail) {
            window.dataLayer.push({ ecommerce: null });
          }
          window.dataLayer.push(message.detail);
        } else if (message.type === "gtag") {
          // gtag.js (Google tag): fire ecommerce event on the host page
          if (typeof window.gtag === "function") {
            // Set customer data for enhanced conversions before the event.
            if (message.userData) {
              window.gtag("set", "user_data", message.userData);
            }
            window.gtag("event", message.eventName, message.params);
          }
        } else if (message.type === "fbPixel") {
          // Meta (Facebook) Pixel: fire standard events on the host page
          if (typeof window.fbq === "function") {
            // Pass hashed customer data as advanced matching (4th arg) when present.
            if (message.userData) {
              window.fbq("track", message.eventName, message.params, message.userData);
            } else {
              window.fbq("track", message.eventName, message.params);
            }
          }
        } else if (message.type === "tiktokPixel") {
          // TikTok Pixel: fire standard events on the host page
          if (window.ttq && typeof window.ttq.track === "function") {
            // identify() goes before track(). The pixel hashes the values
            // itself before they leave the browser.
            if (message.userData && typeof window.ttq.identify === "function") {
              window.ttq.identify(message.userData);
            }
            window.ttq.track(message.eventName, message.params);
          }
        } else if (message.type === "setCart") {
          window.localStorage.setItem(cartStorageKey, message.cartUUID);
        } else if (message.type === "resetCart") {
          window.localStorage.removeItem(cartStorageKey);
          if (options.onResetCart) {
            options.onResetCart();
          }
        } else if (message.type === "setLang") {
          window.localStorage.setItem(langStorageKey, message.lang);
        } else if (message.type === "pageNavigation") {
          if (options.onPageReady) {
            options.onPageReady();
          }
          // The widget is back in the iframe and announcing a new page. If we
          // previously expanded the iframe for an off-origin redirect, undo
          // it now so parent-driven scrolling + setHeight auto-resize resume.
          // Reset the height to lastSize too: setHeight from the new page
          // arrives shortly after pageNavigation, but its shrink path is
          // debounced 500ms, so without this the iframe would visibly hang at
          // viewport height for half a second.
          if (expandedForOffOrigin) {
            iframe.setAttribute("scrolling", "no");
            iframe.style.height = lastSize + "px";
            expandedForOffOrigin = false;
          }
          // Scroll the widget into view if its top is above the viewport, then
          // re-check once shortly after. Right after navigation the iframe
          // height is still in flux (setHeight lands slightly later), so a
          // single smooth scroll can race that reflow and overshoot, leaving
          // the page parked below the embed. The re-check corrects the final
          // position; it's a no-op when the embed is already in view. Kept
          // short so it can't land as a late, jarring jump once the user has
          // settled.
          scrollWidgetIntoView();
          setTimeout(scrollWidgetIntoView, 200);
        } else if (message.type === "externalNavigation") {
          // Widget is about to navigate the iframe to an off-origin URL (e.g.
          // a hosted payment form). Once off-origin we can't postMessage to
          // the inner document, so its content height is invisible to us; if
          // we leave scrolling="no" with the current (widget-sized) height,
          // the off-origin page gets clipped. Drop parent-driven mode and
          // give the iframe enough room to scroll the off-origin page within
          // itself until the customer returns (pageNavigation reverts both).
          clearTimeout(resizingTimeoutId);
          iframe.setAttribute("scrolling", "auto");
          iframe.style.height = window.innerHeight + "px";
          expandedForOffOrigin = true;
        }
      }
    });
  }

  function buzzshotBookingsEmbed(container, insertBefore) {
    var initialPath = (document.currentScript && document.currentScript.getAttribute("data-initial"))
    if (initialPath && initialPath.slice(0,1) === "/") {
      initialPath = "/" + widgetId + initialPath;
    }
    var dataLang = (document.currentScript && document.currentScript.getAttribute("data-lang"))
    var iframeUrl;
    if (initialPath) {
      iframeUrl = new URL(initialPath, defaultIframeUrl).href;
    } else {
      iframeUrl =  defaultIframeUrl;
    }
    // Build query params for cart and language (Safari/iframe localStorage fallback)
    var params = new URLSearchParams();
    if (window.localStorage.getItem(cartStorageKey)) {
      params.set("cart", window.localStorage.getItem(cartStorageKey));
    }
    // Language priority: localStorage > data-lang attribute > default
    var lang = window.localStorage.getItem(langStorageKey) || dataLang;
    if (lang) {
      params.set("lang", lang);
    }
    if (params.toString()) {
      iframeUrl += (iframeUrl.includes("?") ? "&" : "?") + params.toString();
    }

    // Create loading spinner
    var spinner = document.createElement("div");
    spinner.style.cssText = "display:flex;align-items:center;justify-content:center;min-height:" + MIN_HEIGHT + "px;";
    var brandColorLight = brandColor + "33"; // Add 20% opacity (hex: 33)
    spinner.innerHTML = '<div style="display:inline-block;width:48px;height:48px;border:5px solid ' + brandColorLight + ';border-top-color:' + brandColor + ';border-radius:50%;animation:spin 1s linear infinite;"></div><style style="display:none">@keyframes spin{to{transform:rotate(360deg)}}</style>';

    // Create iframe
    var iframe = document.createElement("iframe")
    iframe.style.border = 0;
    iframe.style.width = "100%";
    iframe.style.height = MIN_HEIGHT + "px";
    iframe.style.opacity = 0;
    iframe.style.transition = "opacity 1s ease-in-out";
    iframe.setAttribute("allow", "payment");
    iframe.setAttribute("scrolling", "no");

    // The widget posts pageNavigation once its HTML is parsed, well before
    // the load event, which waits for every image on the page.
    function showIframe() {
      iframe.style.opacity = 1;
      spinner.style.display = "none";
    }
    iframe.onload = showIframe;

    // Set src after onload handler is attached to avoid race condition
    iframe.src = iframeUrl;

    if (insertBefore) {
      container.insertBefore(spinner, insertBefore);
      container.insertBefore(iframe, insertBefore);
    } else {
      container.appendChild(spinner)
      container.appendChild(iframe)
    }

    attachIframeBridge(iframe, {
      onPageReady: showIframe,
      onResetCart: function() {
        // Reload iframe to the default page for this embed code
        // (e.g. a product page from data-initial, or the widget index)
        var resetUrl = initialPath ? new URL(initialPath, defaultIframeUrl).href : defaultIframeUrl;
        var resetParams = new URLSearchParams();
        var resetLang = window.localStorage.getItem(langStorageKey) || dataLang;
        if (resetLang) {
          resetParams.set("lang", resetLang);
        }
        if (resetParams.toString()) {
          resetUrl += (resetUrl.includes("?") ? "&" : "?") + resetParams.toString();
        }
        iframe.src = resetUrl;
      }
    });
  }

  // Takeover mode: don't create any DOM. Find an iframe already pointing at
  // this widget's URL (or wait for one to be inserted) and wire up the
  // parent <-> iframe bridge on it.
  function buzzshotBookingsTakeover() {
    var attached = false;

    function isOurIframe(el) {
      if (!el || el.tagName !== "IFRAME" || !el.src) return false;
      try {
        var u = new URL(el.src, window.location);
        if (u.hostname !== expectedUrl.hostname || u.protocol !== expectedUrl.protocol) return false;
        if (scriptHasWidgetId) {
          // Match iframes whose path contains this widget's UUID. Works for
          // the root URL and for deeper links (e.g. detail/checkout pages).
          return u.pathname.indexOf(widgetId) !== -1;
        }
        // Script was loaded in the default-widget form (no UUID in its path).
        // Match iframes that also use the no-UUID form so we don't hijack a
        // different widget's iframe sitting on the same page.
        return !WIDGET_UUID_PREFIX_RE.test(u.pathname);
      } catch (e) {
        return false;
      }
    }

    function tryAttach(el) {
      if (attached || !isOurIframe(el)) return false;
      attached = true;
      attachIframeBridge(el, {
        onResetCart: function() {
          // We don't know the author's intended initial path, so just reload
          // the current iframe URL after clearing the cart.
          el.src = el.src;
        }
      });
      return true;
    }

    // Check anything already in the DOM.
    var existing = document.getElementsByTagName("iframe");
    for (var i = 0; i < existing.length; i++) {
      if (tryAttach(existing[i])) return;
    }

    // Otherwise watch for one to be inserted (or its src to be set later).
    var observer = new MutationObserver(function(mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var m = mutations[i];
        if (m.type === "attributes") {
          if (tryAttach(m.target)) { observer.disconnect(); return; }
          continue;
        }
        for (var j = 0; j < m.addedNodes.length; j++) {
          var node = m.addedNodes[j];
          if (node.nodeType !== 1) continue;
          if (tryAttach(node)) { observer.disconnect(); return; }
          if (node.getElementsByTagName) {
            var inner = node.getElementsByTagName("iframe");
            for (var k = 0; k < inner.length; k++) {
              if (tryAttach(inner[k])) { observer.disconnect(); return; }
            }
          }
        }
      }
    });
    observer.observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ["src"]
    });
  }

  if (getScriptParam("create") === "no") {
    buzzshotBookingsTakeover();
    return;
  }

  var dataTarget = document.currentScript && document.currentScript.getAttribute("data-target");
  var defaultTarget = "#buzzshot\u002Dembed\u002Dtarget";

  if (customElement) {
    class BuzzshotBookingWidget extends HTMLElement {
      connectedCallback() {
        buzzshotBookingsEmbed(this);
      }
    }

    customElements.define(customElement, BuzzshotBookingWidget);
  } else if (dataTarget) {
    var targetEl = document.querySelector(dataTarget);
    if (targetEl) {
      buzzshotBookingsEmbed(targetEl);
    } else {
      console.error("Buzzshot: target element not found: " + dataTarget);
    }
  } else if (defaultTarget) {
    var defaultEl;
    try { defaultEl = document.querySelector(defaultTarget); } catch(e) {}
    if (defaultEl) {
      buzzshotBookingsEmbed(defaultEl);
    } else if (document.currentScript && document.currentScript.parentNode) {
      buzzshotBookingsEmbed(document.currentScript.parentNode, document.currentScript);
    } else {
      buzzshotBookingsEmbed(document.body);
    }
  } else {
    if (document.currentScript && document.currentScript.parentNode) {
      buzzshotBookingsEmbed(document.currentScript.parentNode, document.currentScript);
    } else {
      buzzshotBookingsEmbed(document.body);
    }
  }
})();
</script>