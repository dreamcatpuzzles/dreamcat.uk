---
import { Image } from "astro:assets";
import { terpeca_2025 } from "../images";
import Row from "./Row.astro";
import InlineLink from "./InlineLink.astro";


---

<Row inverted>
    <div class="flex flex-col items-center">
        <div class="pb-2">
            <InlineLink href="https://mastodon.me.uk/@dreamcat"
                >Mastodon</InlineLink
            >
            {" "}| <InlineLink
                href="https://bsky.app/profile/dreamcatpuzzles.bsky.social"
                >Bluesky</InlineLink
            >
            {" "}| <InlineLink
                href="https://www.linkedin.com/company/dreamcat-puzzles"
                >LinkedIn</InlineLink
            >
            {" "}| <InlineLink href="https://www.instagram.com/dreamcat.puzzles"
                >Instagram</InlineLink
            >
            {" "}| <InlineLink href="https://buttondown.email/DreamcatPuzzles"
                >Newsletter</InlineLink
            >
        </div>
        <Image
            src={terpeca_2025}
            alt="Top Escape Rooms Project Enthusiasts' Choice Awards (TERPECA) 2025 Nominee badge"
            height={200}
            class="text-center"
        />
    </div>
</Row>
